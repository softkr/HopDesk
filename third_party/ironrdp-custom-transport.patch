+/// [PATCH HopDesk] Embedder-supplied byte stream → TLS/CredSSP connection.
+///
+/// The stream is opened by the embedder (e.g. an SSH `direct-tcpip` channel). TLS validation and
+/// CredSSP use `config.destination` as the server name, exactly as for a direct connection.
+async fn connect_custom(
+    config: &Config,
+    custom: &crate::config::CustomTransport,
+    input_sender: &RdpInputSender,
+    output_event_sender: &crate::output_channel::OutputEventSender,
+    cliprdr_factory: CliprdrFactoryRef<'_>,
+    rdpdr_factory: RdpdrFactoryRef<'_>,
+    auto_reconnect_cookie: Option<&ServerAutoReconnect>,
+) -> ConnectorResult<ConnectOutput> {
+    let (stream, client_addr) = custom
+        .connect()
+        .await
+        .map_err(|e| ironrdp_connector::custom_err!("custom transport connect", e))?;
+
+    let framed = ironrdp_tokio::TokioFramed::new(stream);
+    let connector = build_connector(
+        config,
+        client_addr,
+        (input_sender, output_event_sender),
+        cliprdr_factory,
+        rdpdr_factory,
+        RdpdrDevicePolicy::ALLOW_ALL,
+        true,
+        false,
+        auto_reconnect_cookie,
+    )?;
+
+    Box::pin(security_upgrade_and_finalize(framed, connector, config, None)).await
+}
