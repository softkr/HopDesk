+// ── [PATCH HopDesk] Custom transport ──────────────────────────────────────
+
+/// Byte stream usable as an RDP transport.
+pub trait RdpStream: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send + Sync {}
+impl<T> RdpStream for T where T: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send + Sync {}
+
+/// Boxed [`RdpStream`].
+pub type BoxedRdpStream = Box<dyn RdpStream>;
+
+/// Future returned by a [`CustomTransport`] factory: the stream and the client address to report.
+pub type CustomConnectFuture = core::pin::Pin<
+    Box<dyn Future<Output = std::io::Result<(BoxedRdpStream, core::net::SocketAddr)>> + Send>,
+>;
+
+/// Factory opening a fresh transport stream; called once per connection attempt (reconnects included).
+///
+/// TLS, CredSSP and the RDP connection sequence run on top of the stream exactly as for a direct
+/// connection, with [`Config::destination`] used as the server name (TLS validation, CredSSP SPN).
+#[derive(Clone)]
+pub struct CustomTransport {
+    connect: Arc<dyn Fn() -> CustomConnectFuture + Send + Sync>,
+}
+
+impl CustomTransport {
+    pub fn new(connect: impl Fn() -> CustomConnectFuture + Send + Sync + 'static) -> Self {
+        Self {
+            connect: Arc::new(connect),
+        }
+    }
+
+    pub(crate) fn connect(&self) -> CustomConnectFuture {
+        (self.connect)()
+    }
+}
+
+impl fmt::Debug for CustomTransport {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("CustomTransport").finish_non_exhaustive()
+    }
+}
